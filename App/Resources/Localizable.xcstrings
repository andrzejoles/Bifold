    "Otwiera Quick Look dla zaznaczonych elementów.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Quick Look for the selected items."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Übersicht (Quick Look) für die ausgewählten Elemente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Vista rápida para los elementos seleccionados."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває Швидкий перегляд для вибраних елементів."
          }
        }
      }
    },
    "Otwiera katalog spod kursora w drugim panelu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the folder under the cursor in the other panel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Ordner unter dem Cursor im anderen Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la carpeta bajo el cursor en el otro panel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває теку під курсором в іншій панелі."
          }
        }
      }
    },
    "Otwiera katalog w aktywnym (lub wskazanym) panelu; inny serwer albo telefon — w nowej karcie. Ścieżka do pliku otwiera jego katalog i ustawia na nim kursor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a folder in the active (or given) panel; another server or a phone opens in a new tab. A file path opens its folder and puts the cursor on it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen Ordner im aktiven (oder angegebenen) Bereich; ein anderer Server oder ein Telefon öffnet sich in einem neuen Tab. Ein Dateipfad öffnet dessen Ordner und setzt den Cursor darauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una carpeta en el panel activo (o indicado); otro servidor o un teléfono se abre en una pestaña nueva. Una ruta de archivo abre su carpeta y coloca el cursor sobre él."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває теку в активній (або вказаній) панелі; інший сервер або телефон — у новій вкладці. Шлях до файлу відкриває його теку й ставить на нього курсор."
          }
        }
      }
    },
    "Otwiera nową kartę w panelu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a new tab in the panel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen neuen Tab im Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una pestaña nueva en el panel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває нову вкладку в панелі."
          }
        }
      }
    },
    "Otwiera plik w edytorze (domyślnie Nextpad++).": {
      "extractionState": "manual",
