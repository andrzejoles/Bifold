    "Zamyka kartę (ostatnia karta panelu zostaje).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes the tab (the last tab of a panel stays)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließt den Tab (der letzte Tab eines Bereichs bleibt)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la pestaña (la última pestaña de un panel se mantiene)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриває вкладку (остання вкладка панелі залишається)."
          }
        }
      }
    },
    "Zamyka połączenie z serwerem albo telefon z aktywnego panelu wraz z jego kartami (ostatnia karta panelu wraca do katalogu domowego).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes the connection to the server or the phone in the active panel together with its tabs (the panel's last tab returns to the home folder)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließt die Verbindung zum Server oder das Telefon im aktiven Bereich samt seinen Tabs (der letzte Tab des Bereichs kehrt zum Benutzerordner zurück)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la conexión con el servidor o el teléfono del panel activo junto con sus pestañas (la última pestaña del panel vuelve a la carpeta de inicio)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриває з'єднання з сервером або телефон в активній панелі разом з його вкладками (остання вкладка панелі повертається до домашньої теки)."
          }
        }
      }
    },
