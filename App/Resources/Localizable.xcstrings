      }
    },
    "Synchronizacja jedno- lub dwukierunkowa (także z serwerem), zawsze z podglądem; lokalne nadpisywane i usuwane pliki idą do Kosza.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One- or two-way synchronization (also with a server), always with a preview; local overwritten and deleted files go to the Trash."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein- oder beidseitige Synchronisierung (auch mit einem Server), immer mit Vorschau; lokal überschriebene und gelöschte Dateien kommen in den Papierkorb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización unidireccional o bidireccional (también con un servidor), siempre con vista previa; los archivos locales sobrescritos o eliminados van a la Papelera."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно- або двостороння синхронізація (також із сервером), завжди з переглядом; локальні перезаписані й видалені файли потрапляють у Смітник."
          }
        }
      }
    },
