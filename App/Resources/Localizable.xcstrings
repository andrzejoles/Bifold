          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Name (Maske, Regex), Inhalt (ripgrep, Kodierungen), Datum, Größe und Attributen; Ergebnisse wahlweise im Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Búsqueda por nombre (máscara, regex), contenido (ripgrep, codificaciones), fecha, tamaño y atributos; resultados opcionalmente en el panel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук за назвою (маска, regex), вмістом (ripgrep, кодування), датою, розміром і атрибутами; результати за бажанням у панелі."
