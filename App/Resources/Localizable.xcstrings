    },
    "Otwiera podgląd pliku (tekst w wybranym kodowaniu, hex, obrazy).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the file viewer (text in the chosen encoding, hex, images)."
          }
        },
        "de": {
