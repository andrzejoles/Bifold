    "Zmienia nazwy wielu elementów według masek, licznika, dat, metadanych EXIF/multimediów, znajdź-zamień (regex) i wielkości liter; z podglądem.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renames many items using masks, a counter, dates, EXIF/media metadata, find-and-replace (regex) and letter case; with a preview."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benennt viele Elemente nach Masken, Zähler, Daten, EXIF-/Medien-Metadaten, Suchen-Ersetzen (Regex) und Schreibweise um; mit Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renombra muchos elementos con máscaras, contador, fechas, metadatos EXIF/multimedia, buscar y reemplazar (regex) y mayúsculas; con vista previa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейменовує багато елементів за масками, лічильником, датами, метаданими EXIF/мультимедіа, пошуком і заміною (regex) та регістром; з переглядом."
          }
        }
      }
    },
