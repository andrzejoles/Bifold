    "Plik (domyślnie pod kursorem)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File (default: under the cursor)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei (Standard: unter dem Cursor)"
          }
        },
        "es": {
