          }
        }
      }
    },
    "Reguły kolorowania plików — pierwsza pasująca reguła wygrywa. Warunki: olderThan / newerThan (amount, unit: minutes|hours|days|weeks|months|years, field: modified|created), largerThan / smallerThan (bytes), extensions (list), nameMask (mask), nameRegex (pattern), attribute (directory|file|symlink|hidden|executable|readOnly|locked, value). Styl: textColor, backgroundColor (#RRGGBB), bold, italic, strikethrough.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File coloring rules — the first matching rule wins. Conditions: olderThan / newerThan (amount, unit: minutes|hours|days|weeks|months|years, field: modified|created), largerThan / smallerThan (bytes), extensions (list), nameMask (mask), nameRegex (pattern), attribute (directory|file|symlink|hidden|executable|readOnly|locked, value). Style: textColor, backgroundColor (#RRGGBB), bold, italic, strikethrough."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln zum Einfärben von Dateien — die erste passende Regel gewinnt. Bedingungen: olderThan / newerThan (amount, unit: minutes|hours|days|weeks|months|years, field: modified|created), largerThan / smallerThan (bytes), extensions (list), nameMask (mask), nameRegex (pattern), attribute (directory|file|symlink|hidden|executable|readOnly|locked, value). Stil: textColor, backgroundColor (#RRGGBB), bold, italic, strikethrough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglas para colorear archivos — gana la primera regla que coincide. Condiciones: olderThan / newerThan (amount, unit: minutes|hours|days|weeks|months|years, field: modified|created), largerThan / smallerThan (bytes), extensions (list), nameMask (mask), nameRegex (pattern), attribute (directory|file|symlink|hidden|executable|readOnly|locked, value). Estilo: textColor, backgroundColor (#RRGGBB), bold, italic, strikethrough."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила розфарбовування файлів — перемагає перше відповідне правило. Умови: olderThan / newerThan (amount, unit: minutes|hours|days|weeks|months|years, field: modified|created), largerThan / smallerThan (bytes), extensions (list), nameMask (mask), nameRegex (pattern), attribute (directory|file|symlink|hidden|executable|readOnly|locked, value). Стиль: textColor, backgroundColor (#RRGGBB), bold, italic, strikethrough."
          }
        }
      }
    },
