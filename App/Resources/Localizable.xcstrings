    "Włącza algorytmy diffie-hellman-group1/14-sha1, ssh-rsa i szyfry CBC — tylko dla serwerów, które nie znają nowszych.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enables the diffie-hellman-group1/14-sha1 and ssh-rsa algorithms and CBC ciphers — only for servers that don’t know newer ones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert die Algorithmen diffie-hellman-group1/14-sha1, ssh-rsa und CBC-Verschlüsselungen — nur für Server, die keine neueren kennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa los algoritmos diffie-hellman-group1/14-sha1, ssh-rsa y los cifrados CBC — solo para servidores que no conocen otros más nuevos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмикає алгоритми diffie-hellman-group1/14-sha1, ssh-rsa і шифри CBC — лише для серверів, які не знають новіших."
          }
        }
      }
    },
