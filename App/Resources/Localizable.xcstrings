    "Kroki bez konfliktów zostaną wykonane. „Wymuś” cofa też elementy zmienione od czasu operacji.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps without conflicts will be performed. “Force” also undoes items changed since the operation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritte ohne Konflikte werden ausgeführt. „Erzwingen“ macht auch Elemente rückgängig, die sich seit dem Vorgang geändert haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
