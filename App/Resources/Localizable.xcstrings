    "Łączy części .001, .002… w jeden plik i sprawdza sumę, jeśli jest plik .sha256.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joins parts .001, .002… into one file and verifies the checksum if there is a .sha256 file."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt die Teile .001, .002… zu einer Datei zusammen und prüft die Prüfsumme, wenn eine .sha256-Datei vorhanden ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Une las partes .001, .002… en un solo archivo y comprueba la suma si hay un archivo .sha256."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об’єднує частини .001, .002… в один файл і перевіряє суму, якщо є файл .sha256."
          }
        }
      }
    },
