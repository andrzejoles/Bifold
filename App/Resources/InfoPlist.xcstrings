    "NSDesktopFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Menedżer plików wyświetla i zmienia pliki na Biurku."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file manager shows and changes files on the Desktop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dateimanager zeigt und ändert Dateien auf dem Schreibtisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gestor de archivos muestra y modifica los archivos del Escritorio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файловий менеджер показує й змінює файли на Робочому столі."
