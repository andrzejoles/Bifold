// Nazwa robocza aplikacji i bundle id — JEDYNE miejsce, w którym je zmieniasz.
// Kod czyta nazwę z Info.plist (klucz BifoldAppName), katalog danych to
// ~/Library/Application Support/$(BIFOLD_APP_NAME).
BIFOLD_APP_NAME = Bifold
PRODUCT_NAME = $(BIFOLD_APP_NAME)
PRODUCT_BUNDLE_IDENTIFIER = local.aoles.bifold
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
